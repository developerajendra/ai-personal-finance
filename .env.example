# ──────────────────────────────────────────────────
# Server-Level Configuration (required)
# ──────────────────────────────────────────────────

# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_SECRET=same-as-NEXTAUTH_SECRET

# Encryption key for per-user secrets in DB (must be exactly 32 chars)
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key!!

# Google OAuth for "Sign in with Google" (NextAuth). In Google Cloud Console
# (APIs & Services → Credentials → your OAuth 2.0 Client → Authorized redirect URIs) add exactly:
#   http://localhost:3000/api/auth/callback/google
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here

# ──────────────────────────────────────────────────
# Optional / Per-User (moved to Settings page)
# ──────────────────────────────────────────────────

# AI Configuration — provider selection is server-side only and never falls
# back silently. AI_PROVIDER is the default; per-use-case overrides below.
#   providers: gemini | anthropic | openai | ollama
AI_PROVIDER=gemini
# AI_CHAT_PROVIDER=anthropic     # chatbot + WhatsApp
# AI_JSON_PROVIDER=gemini        # structured JSON extraction (imports)
# AI_ANALYSIS_PROVIDER=gemini

# Gemini
AI_CHAT_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (Claude). LLM_API_KEY is accepted as an alias for ANTHROPIC_API_KEY.
# API keys are already scoped to a workspace; ANTHROPIC_WORKSPACE_ID is informational only.
ANTHROPIC_API_KEY=
LLM_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_TOKENS=4096

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Configuration (if using Ollama locally)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3:latest

# Zerodha Kite API (fallback; users add their own in Settings)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=http://localhost:3000/api/zerodha/callback

# Portfolio Agent
PORTFOLIO_AGENT_ENABLED=true
PORTFOLIO_AGENT_INTERVAL=300000

# Node Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────
# WhatsApp Business (Cloud API)
# ──────────────────────────────────────────────────
# Webhook URL to register in Meta App Dashboard: https://<host>/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=                 # App Dashboard → App settings → Basic → App secret
WHATSAPP_ACCESS_TOKEN=               # System-user permanent token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# WHATSAPP_RATE_LIMIT_MAX=20
# WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=600
# WHATSAPP_MAX_ATTEMPTS=5

# Secret for the retry sweeper at /api/jobs/whatsapp (sent as "Authorization: Bearer <secret>";
# Vercel Cron sends CRON_SECRET automatically).
CRON_SECRET=generate-with-openssl-rand-hex-32

# ──────────────────────────────────────────────────
# Local development only — NEVER set in Vercel/production
# ──────────────────────────────────────────────────
# Clicking "Sign In" logs in as DEV_AUTH_EMAIL without a password.
# Ignored when NODE_ENV=production (next build / next start).
# DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL=dev@localhost.test
